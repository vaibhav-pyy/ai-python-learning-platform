# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# Variables already set in your shell take precedence over this file.

# Required for AI hints and feedback — a Hugging Face access token
# (https://huggingface.co/settings/tokens) with permission to call Inference Providers.
HF_TOKEN=hf_your_token_here

# Optional settings (defaults shown)
# HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct:nscale
# LP_LLM_TIMEOUT=60
# LP_DB_PATH=learning_platform.db
# LP_SEED_DEMO_ACCOUNTS=1
# LP_LOG_LEVEL=WARNING
